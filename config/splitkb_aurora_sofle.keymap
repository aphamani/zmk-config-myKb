#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// Uncomment this block if using RGB

&led_strip { chain-length = <6>; };

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  BKSP |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   \   |
            // | LCTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |  ENT  |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | APOS  |
            //               |CTRL | ALT  | GUI  | SPACE|  LOWER |  | RCTRL | LARW | DARW  | UARW  | RARW |

            bindings = <
&kp GRAVE  &kp N1  &kp N2     &kp N3    &kp N4    &kp N5                         &kp N6        &kp N7          &kp N8      &kp N9           &kp N0    &kp BSPC
&kp TAB    &kp Q   &kp W      &kp E     &kp R     &kp T                          &kp Y         &kp U           &kp I       &kp O            &kp P     &kp BSLH
&kp LCTRL  &kp A   &kp S      &kp D     &kp F     &kp G                          &kp H         &kp J           &kp K       &kp L            &kp SEMI  &kp RET
&kp LSHFT  &kp Z   &kp X      &kp C     &kp V     &kp B   &kp LBKT     &kp RBKT  &kp N         &kp M           &kp COMMA   &kp DOT          &kp FSLH  &kp APOS
                   &kp LCTRL  &kp LALT  &kp LGUI  &mo 1   &kp SPACE    &mo 2     &msc SCRL_UP  &msc SCRL_DOWN  &kp ESCAPE  &kp PRINTSCREEN
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |       |     |     |      |  _   |  -   |                   |  +   |  =    |       |      |       |       |
            // |       |     |     |      |      |      |                   |  {   |   }   |       |      |       |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&kp TILDE  &kp LC(EXCLAMATION)  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT                        &kp CARET    &kp AMPERSAND   &kp ASTERISK    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans     &trans               &trans       &trans    &kp LBKT    &kp RBKT                           &kp LBRC     &kp RBRC        &kp UP_ARROW    &trans                &trans                 &trans
&trans     &trans               &trans       &trans    &trans      &kp MINUS                          &kp KP_PLUS  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT             &trans                 &trans
&trans     &trans               &trans       &trans    &trans      &kp UNDER    &kp LBKT    &kp RBKT  &kp EQUAL    &trans          &trans          &trans                &trans                 &trans
                                &trans       &trans    &trans      &trans       &kp UARW    &kp DARW  &trans       &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |       |     |     |      |      |      |                   |VOL_UP|       |       |      |       |       |
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&kp ESC  &trans  &trans  &trans  &trans        &trans                          &trans        &trans        &trans      &trans  &trans  &kp C_SLEEP
&trans   &trans  &trans  &trans  &trans        &trans                          &trans        &trans        &trans      &trans  &trans  &trans
&trans   &trans  &trans  &trans  &kp C_BRI_DN  &kp C_BRI_UP                    &kp C_VOL_DN  &kp C_VOL_UP  &kp C_MUTE  &trans  &trans  &trans
&trans   &trans  &trans  &trans  &trans        &trans        &trans    &trans  &trans        &trans        &trans      &trans  &trans  &trans
                 &trans  &trans  &trans        &trans        &trans    &trans  &trans        &trans        &trans      &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
