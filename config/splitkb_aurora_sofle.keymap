#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

// Uncomment this block if using RGB

&led_strip { chain-length = <6>; };

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  BKSP |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   \   |
            // | LCTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |  ENT  |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | APOS  |
            //               |CTRL | ALT  | GUI  | SPACE|  LOWER |  | RCTRL | LARW | DARW  | UARW  | RARW |

            bindings = <
&kp GRAVE       &kp N1            &kp N2       &kp N3      &kp N4      &kp N5                           &kp N6  &kp N7         &kp N8      &kp N9       &kp N0                &kp BSPC
&kp TAB         &kp Q             &kp W        &kp E       &kp R       &kp T                            &kp Y   &kp U          &kp I       &kp O        &kp P                 &kp BSLH
&kp LEFT_SHIFT  &hm LEFT_SHIFT A  &hm LCTRL S  &hm LALT D  &hm LGUI F  &kp G                            &kp H   &hm RGUI J     &hm RALT K  &hm RCTRL L  &hm RIGHT_SHIFT SEMI  &kp RET
&kp LCTRL       &kp Z             &kp X        &kp C       &kp V       &kp B      &kp LBKT    &kp RBKT  &kp N   &kp M          &kp COMMA   &kp DOT      &kp FSLH              &kp APOS
                                  &kp LCTRL    &kp LALT    &kp LGUI    &kp SPACE  &mo 1       &kp ESC   &mo 2   &kp BACKSPACE  &kp LCTRL   &kp DEL
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |       |     |     |      |  _   |  -   |                   |  +   |  =    |       |      |       |       |
            // |       |     |     |      |      |      |                   |  {   |   }   |       |      |       |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&kp TILDE  &kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT                        &kp CARET  &kp AMPERSAND  &kp ASTERISK   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans     &trans           &trans       &trans    &kp LBKT    &kp RBKT                           &kp LBRC   &kp RBRC       &kp LESS_THAN  &kp GREATER_THAN      &trans                 &trans
&trans     &trans           &trans       &trans    &trans      &kp MINUS                          &kp EQUAL  &kp BACKSPACE  &none          &none                 &trans                 &trans
&trans     &trans           &trans       &trans    &trans      &kp UNDER    &kp LBKT    &kp RBKT  &kp PLUS   &trans         &kp LESS_THAN  &kp GREATER_THAN      &trans                 &trans
                            &trans       &trans    &trans      &trans       &none       &none     &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |       |     |     |      |      |      |                   |VOL_UP|       |       |      |       |       |
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5        &kp F6                          &kp F7           &kp F8      &kp F9        &kp F10    &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans        &trans                          &trans           &trans      &kp UP_ARROW  &trans     &trans   &trans
&trans  &trans  &trans  &trans  &kp C_BRI_DN  &kp C_BRI_UP                    &kp C_VOL_DN     &kp LEFT    &kp DOWN      &kp RIGHT  &trans   &trans
&trans  &trans  &trans  &trans  &trans        &trans        &trans    &trans  &kp C_VOLUME_UP  &kp C_MUTE  &trans        &trans     &trans   &trans
                &trans  &trans  &trans        &trans        &trans    &trans  &trans           &trans      &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
