#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

// Uncomment this block if using RGB

&led_strip { chain-length = <6>; };

/ {
    macros {
        Excla: Excla {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LSHFT &kp N1>;
            label = "EXCLA";
        };

        changeScreen: changeScreen {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LCTRL &kp LEFT_ALT &kp NUMBER_1>;
            label = "CHANGESCREEN";
        };

        fullScreen: fullScreen {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LCTRL &kp LEFT_ALT &kp ENTER>;
            label = "FULLSCREEN";
        };
    };

    combos {
        compatible = "zmk,combos";

        Home {
            bindings = <&kp LC(GRAVE)>;
            key-positions = <57>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  BKSP |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   \   |
            // | LCTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |  ENT  |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | APOS  |
            //               |CTRL | ALT  | GUI  | SPACE|  LOWER |  | RCTRL | LARW | DARW  | UARW  | RARW |

            bindings = <
&kp GRAVE       &kp N1  &kp N2     &kp N3    &kp N4    &kp N5                           &kp N6  &kp N7         &kp N8     &kp N9           &kp N0    &kp BSPC
&kp TAB         &kp Q   &kp W      &kp E     &kp R     &kp T                            &kp Y   &kp U          &kp I      &kp O            &kp P     &kp BSLH
&kp LEFT_SHIFT  &kp A   &kp S      &kp D     &kp F     &kp G                            &kp H   &kp J          &kp K      &kp L            &kp SEMI  &kp RET
&kp LCTRL       &kp Z   &kp X      &kp C     &kp V     &kp B      &kp LBKT    &kp RBKT  &kp N   &kp M          &kp COMMA  &kp DOT          &kp FSLH  &kp APOS
                        &kp LCTRL  &kp LALT  &kp LGUI  &kp SPACE  &mo 1       &kp ESC   &mo 2   &kp BACKSPACE  &kp LCTRL  &kp PRINTSCREEN
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        lower_layer {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   |      |       |       |      |       |       |
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |       |     |     |      |  _   |  -   |                   |  +   |  =    |       |      |       |       |
            // |       |     |     |      |      |      |                   |  {   |   }   |       |      |       |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&kp TILDE  &Excla  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT                        &kp CARET  &kp AMPERSAND  &kp ASTERISK   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans
&trans     &trans  &trans       &trans    &kp LBKT    &kp RBKT                           &kp LBRC   &kp RBRC       &kp LESS_THAN  &kp GREATER_THAN      &trans                 &trans
&trans     &trans  &trans       &trans    &trans      &kp MINUS                          &kp EQUAL  &kp BACKSPACE  &none          &none                 &trans                 &trans
&trans     &trans  &trans       &trans    &trans      &kp UNDER    &kp LBKT    &kp RBKT  &kp PLUS   &trans         &kp LESS_THAN  &kp GREATER_THAN      &trans                 &trans
                   &trans       &trans    &trans      &trans       &kp UARW    &kp DARW  &trans     &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        raise_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |       |     |     |      |      |      |                   |VOL_UP|       |       |      |       |       |
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5        &kp F6                          &kp F7           &kp F8      &kp F9        &kp F10    &kp F11  &kp F12
&trans  &trans  &trans  &trans  &trans        &trans                          &trans           &trans      &kp UP_ARROW  &trans     &trans   &trans
&trans  &trans  &trans  &trans  &kp C_BRI_DN  &kp C_BRI_UP                    &kp C_VOL_DN     &kp LEFT    &kp DOWN      &kp RIGHT  &trans   &trans
&trans  &trans  &trans  &trans  &trans        &trans        &trans    &trans  &kp C_VOLUME_UP  &kp C_MUTE  &trans        &trans     &trans   &trans
                &trans  &trans  &trans        &trans        &trans    &trans  &trans           &trans      &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };
    };
};
