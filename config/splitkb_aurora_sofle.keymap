#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

// Uncomment this block if using RGB

&led_strip { chain-length = <6>; };

/ {
    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <0>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |  BKSP |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   \   |
            // | LCTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |  ENT  |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |   "["  |  |  "]"  |  N   |  M    |  ,    |  .   |   /   | APOS  |
            //               |CTRL | ALT  | GUI  | SPACE|  LOWER |  | RCTRL | LARW | DARW  | UARW  | RARW |

            bindings = <
&kp TAB         &kp Q             &kp W        &kp E           &kp R       &kp T                            &kp Y      &kp U       &kp I       &kp O             &kp P                       &kp BSPC
&kp TAB         &hm LEFT_SHIFT A  &hm LCTRL S  &hm LEFT_ALT D  &hm LCMD F  &kp G                            &kp H      &hm RGUI J  &hm RALT K  &hm LCTRL L       &hm RSHIFT SEMICOLON        &kp SQT
&kp LEFT_SHIFT  &kp Z             &kp X        &kp C           &kp V       &kp B                            &kp N      &kp M       &kp COMMA   &hm EQUAL PERIOD  &hm NON_US_BACKSLASH SLASH  &kp EXCLAMATION
&none           &none             &none        &none           &to 1       &kp SPACE  &kp LBKT    &kp RBKT  &kp ENTER  &mo 3       &none       &none             &none                       &none
                                  &none        &none           &none       &none      &none       &none     &none      &none       &none       &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_2 {
            bindings = <
&trans  &trans       &trans         &kp ASTERISK  &trans  &trans                       &trans    &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp PLUS        &trans  &trans
&trans  &kp AT_SIGN  &kp AMPERSAND  &kp DOLLAR    &trans  &kp PLUS                     &kp HASH  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp MINUS       &trans  &trans
&trans  &trans       &trans         &kp CARET     &trans  &kp MINUS                    &trans    &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp UNDERSCORE  &trans  &trans
&trans  &trans       &trans         &trans        &to 2   &trans     &trans    &trans  &trans    &trans                &trans                 &trans          &trans  &trans
                     &trans         &trans        &trans  &trans     &to 0     &trans  &trans    &trans                &trans                 &trans
            >;
        };

        raise_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |       |     |     |      |      |      |                   |VOL_UP|       |       |      |       |       |
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            //               |     |      |      |      |        |  |       |      |       |       |      |

            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4   &kp F5   &kp F6                     &trans        &kp SLASH     &kp ASTERISK  &kp MINUS     &kp PLUS  &trans
&kp F7  &kp F8  &kp F9  &kp F10  &kp F11  &kp F12                    &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp N5    &trans
&trans  &trans  &trans  &trans   &trans   &trans                     &kp NUMBER_6  &kp N7        &kp N8        &kp N9        &kp N0    &trans
&trans  &trans  &trans  &trans   &to 0    &to 1    &trans    &trans  &kp COMMA     &kp PERIOD    &trans        &trans        &trans    &trans
                &trans  &trans   &trans   &trans   &to 0     &trans  &trans        &trans        &trans        &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &kp K_SCROLL_UP    &trans  &trans                    &trans  &trans          &kp UP_ARROW    &trans           &trans      &trans
&trans  &trans  &trans  &kp K_SCROLL_DOWN  &trans  &trans                    &trans  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp ESCAPE  &trans
&trans  &trans  &trans  &trans             &trans  &trans                    &trans  &none           &none           &none            &trans      &trans
&trans  &trans  &trans  &trans             &trans  &trans  &trans    &trans  &trans  &trans          &trans          &trans           &trans      &trans
                &trans  &trans             &trans  &trans  &trans    &trans  &trans  &trans          &trans          &trans
            >;
        };
    };
};
